<?xml version="1.0" encoding="UTF-8"?>
<!-- Rules for versions-maven-plugin (referenced from root pom.xml pluginManagement). -->
<ruleset comparisonMethod="maven"
         xmlns="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0 https://www.mojohaus.org/versions-maven-plugin/xsd/rule-2.0.0.xsd">
    <ignoreVersions>
        <!-- Ignore unstable / pre-release qualifiers when suggesting updates. -->
        <ignoreVersion type="regex">(?i).*[-.](alpha|beta|rc|cr|m\d+|milestone|snapshot|preview|ea|dev).*</ignoreVersion>
    </ignoreVersions>
</ruleset>
